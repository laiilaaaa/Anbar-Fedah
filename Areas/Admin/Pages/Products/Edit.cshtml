@page "{id:int}"
@model jewllery_keep.Areas.Admin.Pages.Products.EditModel
@{
    ViewData["Title"] = "Edit Product";
}

<h2>Edit Product</h2>

<form method="post">
    <input type="hidden" asp-for="Product.Id" />

    <div class="mb-3">
        <input asp-for="Product.Name" class="form-control" placeholder="Name" />
        <span asp-validation-for="Product.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <input asp-for="Product.Price" class="form-control" placeholder="Price" />
        <span asp-validation-for="Product.Price" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <input asp-for="Product.Stock" class="form-control" placeholder="Stock" />
        <span asp-validation-for="Product.Stock" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <textarea asp-for="Product.Description" class="form-control" placeholder="Description"></textarea>
    </div>
    <div class="mb-3">
        <input asp-for="Product.ImageUrl" class="form-control" placeholder="Image URL" />
    </div>

    <button type="submit" class="btn btn-success">Save Changes</button>
    <a asp-page="/ManageProducts" asp-area="Admin" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
