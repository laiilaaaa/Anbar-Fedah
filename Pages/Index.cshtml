@page
@model jewllery_keep.Areas.Customer.Pages.ProductsModel
@{
    ViewData["Title"] = "Welcome";
}

<div class="container mt-5">

    <ul class="list-unstyled row">
        @foreach (var p in Model.Products.Take(6))  @* Show only 6 preview products *@
        {
            <li class="col-md-4 mb-3">
                <div class="card p-3 shadow-sm">
                    <h5>@p.Name</h5>
                    <p>$@p.Price</p>
                </div>
            </li>
        }
    </ul>

