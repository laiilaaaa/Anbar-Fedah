@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Jewllery Keep</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- STICKY HEADER / NAVBAR -->
    <header class="sticky-header">
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-3">
            <!-- direction:ltr forces the 3 columns into a fixed left/center/right order
                 regardless of the page being RTL, so "left" and "right" always mean
                 the visual left/right side of the screen. -->
            <div class="container-fluid navbar-3col" style="direction: ltr;">

                <!-- LEFT: Cart + Search icon -->
                <div class="d-flex align-items-center justify-content-start" style="gap: 16px;">
                    <a href="/Customer/Cart">
                        <img src="~/images/shopping cart.png" alt="Cart" style="width:28px; height:28px;">
                    </a>
                    <button type="button" class="icon-btn" onclick="openCategoryPanel()" aria-label="Search">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="7"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </button>
                </div>

                <!-- CENTER: Brand -->
                <div class="text-center">
                    <a class="navbar-brand fw-bold m-0" asp-area="" asp-page="/Index" style="direction: rtl; display:inline-block;"> متجر للفضة</a>
                </div>

                <!-- RIGHT: Login / Register, or profile icon once signed in -->
                <div class="d-flex align-items-center justify-content-end" dir="rtl" style="direction: rtl;">
                    <ul class="navbar-nav d-flex align-items-center flex-row">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item dropdown">
                                <button class="profile-icon-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="7" r="4"></circle>
                                        <path d="M4 21v-1a8 8 0 0 1 16 0v1"></path>
                                    </svg>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" dir="rtl">
                                    <li>
                                        <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                                            مرحباً @User.Identity?.Name!
                                        </a>
                                    </li>
                                    <li>
                                        <form asp-area="Identity" asp-page="/Account/Logout"
                                              asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
                                            <button type="submit" class="dropdown-item">تسجيل الخروج</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <button class="btn logbtn" data-bs-toggle="modal" data-bs-target="#authModal"
                                        onclick="showForm('login')">
                                    تسجيل الدخول
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="btn regbtn" data-bs-toggle="modal" data-bs-target="#authModal"
                                        onclick="showForm('register')">
                                    إنشاء حساب
                                </button>
                            </li>
                        }
                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <!-- SLIDE-IN SEARCH / CATEGORY PANEL -->
    <div class="category-panel-overlay" id="categoryOverlay" onclick="closeCategoryPanel()"></div>
    <div class="category-panel" id="categoryPanel">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <strong>البحث والتصنيفات</strong>
            <button type="button" class="close-panel-btn" onclick="closeCategoryPanel()" aria-label="Close">×</button>
        </div>

        <form asp-area="Customer" asp-page="/Products" method="get">
            <input class="search-input-small" type="search" name="query"
                   placeholder="ابحث عن منتجات...">
        </form>

        <ul class="category-list">
            @for (int i = 1; i <= 7; i++)
            {
                <li>
                    <form asp-area="Customer" asp-page="/Products" method="get">
                        <input type="hidden" name="category" value="cat@(i)" />
                        <button type="submit">cat@(i)</button>
                    </form>
                </li>
            }
        </ul>
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- AUTH MODAL -->
    <div class="modal fade" id="authModal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-4">
                <div class="modal-header border-0">
                    <h5 class="modal-title" id="authTitle">Login</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- LOGIN FORM -->
                    <form method="post" id="loginForm" asp-area="Customer" asp-page="/Auth/Login">
                        <div class="mb-3">
                            <input type="email" name="Email" class="form-control" placeholder="Email" required />
                        </div>
                        <div class="mb-3">
                            <input type="password" name="Password" class="form-control" placeholder="Password" required />
                        </div>
                        <input type="hidden" name="ReturnUrl" value="/Customer/Products" />
                        <button type="submit" class="btn btn-success w-100">تسجيل الدخول</button>
                        <div class="text-center mt-3">
                            <small>لا تملك حساب؟ <a href="#" onclick="showForm('register')">إنشاء حساب</a></small>
                        </div>
                    </form>

                    <!-- REGISTER FORM -->
                    <form method="post" id="registerForm" asp-area="Customer" asp-page="/Auth/Register" style="display:none;">
                        <div class="mb-3">
                            <input type="email" name="Email" class="form-control" placeholder="Email" required />
                        </div>
                        <div class="mb-3">
                            <input type="password" name="Password" class="form-control" placeholder="Password" required />
                        </div>
                        <div class="mb-3">
                            <input type="password" name="ConfirmPassword" class="form-control" placeholder="Confirm Password" required />
                        </div>

                        <input type="hidden" name="ReturnUrl" value="/Customer/Products" />
                        <button type="submit" class="btn btn-success w-100">إنشاء حساب</button>

                        <div class="text-center mt-3">
                            <small>
                                تملك حساب بالفعل؟
                                <a href="#" onclick="showForm('login'); return false;"> تسجيل الدخول</a>
                            </small>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function showForm(type) {
            if (type === 'login') {
                document.getElementById('loginForm').style.display = 'block';
                document.getElementById('registerForm').style.display = 'none';
                document.getElementById('authTitle').innerText = 'تسجيل الدخول';
            } else {
                document.getElementById('loginForm').style.display = 'none';
                document.getElementById('registerForm').style.display = 'block';
                document.getElementById('authTitle').innerText = 'إنشاء حساب';
            }
        }

        function openCategoryPanel() {
            document.getElementById('categoryPanel').classList.add('open');
            document.getElementById('categoryOverlay').classList.add('open');
        }

        function closeCategoryPanel() {
            document.getElementById('categoryPanel').classList.remove('open');
            document.getElementById('categoryOverlay').classList.remove('open');
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>